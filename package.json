{
  "name": "overcast-gaming",
  "version": "2.0.0",
  "description": "Overcast Gaming — Warhammer 40K League Site (Portland, OR)",
  "type": "module",
  "scripts": {
    "dev": "node -r dotenv/config node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "postinstall": "npm run build",
    "start": "node -r dotenv/config build/index.js",
    "preview": "vite preview",
    "migrate": "node --env-file=.env scripts/migrate-to-pg.js",
    "test:api": "npm run build && node --env-file=.env scripts/api-integration-test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test": "npm run test:smoke && npm run test:api"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.21.4",
    "dotenv": "^17.3.1",
    "svelte": "^5.34.7",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Overcast Gaming",
  "license": "MIT"
}
