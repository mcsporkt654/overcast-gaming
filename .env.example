# PostgreSQL connection string
# Local dev:    postgres://user:password@localhost:5432/overcast
# Render:       use the Internal Database URL from your Render Postgres dashboard
DATABASE_URL=postgres://user:password@localhost:5432/overcast

# Admin panel password (checked server-side, never exposed to the client)
ADMIN_PASSWORD=your-strong-password-here

# Secret used to sign admin JWT tokens — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Port (Render injects this automatically; only set locally if needed)
PORT=3459
